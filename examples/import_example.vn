// Import bool constants from standard library
import "std/bool.vn"

var flag = true
if flag {
    print("Flag is true")
} else {
    print("Flag is false")
}

// Using false
var done = false
while done == false {
    var ans = input("Continue? (y/n): ")
    if ans == "y" {
        done = true
    }
}
if done {
    print("You chose to stop the loop.")
}
print("Loop ended.")